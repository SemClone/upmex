{
  "api": {
    "clearlydefined": {
      "enabled": true,
      "base_url": "https://api.clearlydefined.io",
      "timeout": 30,
      "api_key": null
    },
    "purldb": {
      "enabled": true,
      "base_url": "https://public.purldb.io",
      "timeout": 30,
      "api_key": null
    },
    "vulnerablecode": {
      "enabled": true,
      "base_url": "https://public.vulnerablecode.io",
      "timeout": 30,
      "api_key": null
    },
    "ecosystems": {
      "enabled": true,
      "base_url": "https://packages.ecosyste.ms/api/v1",
      "timeout": 30,
      "api_key": null
    }
  },
  "extraction": {
    "max_file_size": 500000000,
    "temp_dir": null
  },
  "output": {
    "format": "json",
    "pretty_print": false,
    "include_raw_metadata": false
  },
  "logging": {
    "level": "INFO",
    "format": "%(asctime)s - %(name)s - %(levelname)s - %(message)s",
    "file": null
  }
}
